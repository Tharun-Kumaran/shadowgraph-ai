# ShadowGraph AI Environment Configuration

# Server
SHADOWGRAPH_ENVIRONMENT=development
SHADOWGRAPH_LOG_LEVEL=INFO
SHADOWGRAPH_API_KEY=dev-shadowgraph-key

# Neo4j Graph Database
SHADOWGRAPH_NEO4J_URI=bolt://localhost:7688
SHADOWGRAPH_NEO4J_USER=neo4j
SHADOWGRAPH_NEO4J_PASSWORD=shadowgraph_secret_password
SHADOWGRAPH_NEO4J_DATABASE=neo4j

# Local AI (Ollama)
SHADOWGRAPH_LLM_ENABLED=true
SHADOWGRAPH_OLLAMA_BASE_URL=http://localhost:11434
SHADOWGRAPH_OLLAMA_MODEL=qwen3:1.7b

# Ingestion & Tor (Disabled by default)
SHADOWGRAPH_TOR_ENABLED=false
SHADOWGRAPH_TOR_PROXY=socks5h://127.0.0.1:9050

# CERT-In Incident Reporting
SHADOWGRAPH_CERTIN_REPORTING_WINDOW_HOURS=6
